{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.neuruh.com/public-commons/evidence-envelope/v0.1.json",
  "title": "Neuruh Evidence Envelope v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "subject",
    "status",
    "value",
    "evidence_refs",
    "gaps",
    "producer",
    "produced_at"
  ],
  "properties": {
    "schema_version": {
      "const": "neuruh.evidence-envelope.v0.1"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "status": {
      "enum": ["supported", "observed", "abstained", "contradicted"]
    },
    "value": {},
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_type", "retrieved_at", "content_hash"],
        "properties": {
          "source_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "citation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "uri": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "input_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["supported", "observed"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "abstained"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          },
          "gaps": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
