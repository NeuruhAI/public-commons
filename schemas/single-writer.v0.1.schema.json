{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.neuruh.com/public-commons/single-writer/v0.1.json",
  "title": "Neuruh Single-Writer Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domains"],
  "properties": {
    "schema_version": {
      "const": "neuruh.single-writer.v0.1"
    },
    "domains": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9._-]{1,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["writer"],
        "properties": {
          "writer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "consumers": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "restriction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  }
}
